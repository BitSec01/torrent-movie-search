BETTER_AUTH_SECRET=your-secret-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
OMDB_API_KEY=testt
OPENAI_API_KEY=your-openai-api-key
QBITTORRENT_HOST=http://192.168.1.26:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional. Root of the media library; Movies/, Series/ and torrents/ hang off it.
STORAGE_ROOT=/mnt/storage

# Optional. Override when the ThePirateBay mirror moves.
TPB_BASE=https://www3.thepiratebay3.to

# Optional. Swap models without a rebuild. The chat agent loops up to 10 times
# per message, so its model drives nearly all API cost; the organiser runs once
# per download and is cheap regardless.
CHAT_MODEL=gpt-5.4-nano
ORGANIZE_MODEL=gpt-5.4-mini

# Optional. Completed downloads are organised automatically on a timer.
# Set AUTO_ORGANIZE=false to go back to organising by hand.
AUTO_ORGANIZE=true
AUTO_ORGANIZE_INTERVAL_MS=300000
