BETTER_AUTH_SECRET=your-secret-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required. TMDB is the primary metadata source — posters, plots, cast,
# certifications, TV coverage, no daily request cap. Register free at
# https://www.themoviedb.org/settings/api and paste either the v3 API key or the
# v4 read access token; both are accepted.
TMDB_API_KEY=

# Optional. OMDb is additive on top of TMDB: it supplies the Rotten Tomatoes and
# Metacritic scores, awards and the IMDb rating, which TMDB has no equivalent
# for. Leave empty to skip it — nothing breaks without it.
# A new OMDb key is inert until the activation link in its signup email is
# opened; until then every call answers 401 "Invalid API key!".
OMDB_API_KEY=

# Optional. Point at any host that speaks OMDb's request/response shape to use
# it instead of omdbapi.com.
# OMDB_BASE_URL=https://www.omdbapi.com

OPENAI_API_KEY=your-openai-api-key
QBITTORRENT_HOST=http://192.168.1.26:8080
# Only needed when the app reaches qBittorrent from outside AuthSubnetWhitelist —
# a container talking to the host does, even though the host itself is exempt.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional. Root of the media library; Movies/, Series/ and torrents/ hang off it.
STORAGE_ROOT=/mnt/storage

# Optional. Override when the ThePirateBay mirror moves.
TPB_BASE=https://www3.thepiratebay3.to

# Optional. Swap models without a rebuild. The chat agent loops up to 10 times
# per message, so its model drives nearly all API cost; the organiser runs once
# per download and is cheap regardless.
# The chat agent has to name a film from the user's description before it can
# search for it, so the nano tier is too small — it searches the description
# instead and finds nothing.
CHAT_MODEL=gpt-5.4-mini
ORGANIZE_MODEL=gpt-5.4-mini

# Optional. Completed downloads are organised automatically on a timer.
# Set AUTO_ORGANIZE=false to go back to organising by hand.
AUTO_ORGANIZE=true
AUTO_ORGANIZE_INTERVAL_MS=300000
